{
  "name": "midas-belize",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3123",
    "build": "next build --webpack",
    "start": "next start -p 3123",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "firebase emulators:exec --only firestore,storage 'NODE_OPTIONS=--expose-gc vitest run --config vitest.integration.config.ts'",
    "dev:emulators": "firebase emulators:start --only firestore,storage --import=.emulator-data --export-on-exit=.emulator-data",
    "preprocess": "tsx scripts/pre-process/cli.ts",
    "audit:catalog": "tsx scripts/pre-process/audit-catalog.ts",
    "drive:consent": "tsx scripts/pre-process/get-drive-refresh-token.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.0",
    "@deck.gl/core": "^9.3.0",
    "@deck.gl/geo-layers": "^9.3.0",
    "@deck.gl/layers": "^9.3.0",
    "@deck.gl/mapbox": "^9.3.0",
    "@deck.gl/mesh-layers": "^9.3.0",
    "@google-cloud/firestore": "^8.5.0",
    "@google-cloud/storage": "^7.19.0",
    "@loaders.gl/3d-tiles": "^4.4.1",
    "@loaders.gl/core": "^4.4.1",
    "@turf/turf": "^7.3.4",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.6.2",
    "h3-js": "^4.4.0",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^5.23.0",
    "next": "16.2.3",
    "nuqs": "^2.8.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-react": "^6.0.1",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "firebase-tools": "^15.15.0",
    "jotai": "^2.19.1",
    "jsdom": "^29.0.2",
    "lucide-react": "^1.8.0",
    "prettier": "^3.8.3",
    "proj4": "^2.20.8",
    "shapefile": "^0.6.6",
    "shpjs": "^6.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
