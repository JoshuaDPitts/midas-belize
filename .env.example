# Copy to .env.local for local dev.

# Firebase — produced by `firebase apps:sdkconfig` for the web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=midas-data
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — service-account JSON path (production) or absent (Cloud Run auto-auth)
GOOGLE_APPLICATION_CREDENTIALS=

# Local dev: use emulators instead of production Firebase
USE_EMULATORS=

# GitHub PAT for repository_dispatch (used by route handlers)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Google Drive — service account scoped to the watched folder
DRIVE_SERVICE_ACCOUNT_KEY=
DRIVE_ROOT_FOLDER_ID=

# Slack webhook for failure alerts (used by alert-on-failure Function)
SLACK_ALERT_WEBHOOK=
